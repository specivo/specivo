{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specivo.io/schemas/import-bundle/v1/watchers.schema.json",
  "title": "Import bundle v1: watchers.jsonl",
  "description": "One subscription of a user to an issue or wiki page per line.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "container_kind",
    "container_ref",
    "user_ref"
  ],
  "properties": {
    "container_kind": {
      "type": "string",
      "enum": [
        "issue",
        "wiki_page"
      ]
    },
    "container_ref": {
      "$ref": "common.schema.json#/$defs/sourceRef"
    },
    "user_ref": {
      "$ref": "common.schema.json#/$defs/sourceRef"
    },
    "extra": {
      "$ref": "common.schema.json#/$defs/extra"
    }
  }
}
