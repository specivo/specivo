# Specivo secrets — DO NOT COMMIT this file.
# Copy to .env.local and fill in real values, or run: make configure

# Generate: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change-me-generate-a-real-secret-key

# Override database password for production
# POSTGRES_PASSWORD=strong-production-password
# DATABASE_URL=postgresql+asyncpg://specivo:strong-production-password@specivo-db:5432/specivo

# CAPTCHA (hCaptcha or Cloudflare Turnstile)
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=
