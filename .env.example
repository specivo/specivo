# Specivo environment configuration
#
# Generated by: make configure (or python scripts/configure.py)
# Two files:
#   .env       — committed to git, non-sensitive defaults
#   .env.local — NOT committed, contains secrets (SECRET_KEY)

# --- Instance name ---
# Set this to run multiple Specivo instances on the same host.
# Each instance gets isolated containers, networks, and volumes.
# Examples: specivo, specivo-eng, specivo-staging
COMPOSE_PROJECT_NAME=specivo

# --- External port (nginx) ---
SPECIVO_PORT=9933

# --- Data directory ---
# All persistent data: database files, logs, themes, attachments.
SPECIVO_DATA_DIR=./specivo-data

# --- Image version ---
# Docker Hub image tag. Use 'latest' or pin to a release (e.g., '0.2.0').
SPECIVO_VERSION=latest

# --- Database ---
# Bundled: postgresql+asyncpg://specivo:specivo@db:5432/specivo
# External: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://specivo:specivo@db:5432/specivo

# Bundled PostgreSQL settings (used by docker-compose)
POSTGRES_DB=specivo
POSTGRES_USER=specivo
POSTGRES_PASSWORD=specivo

# --- Redis ---
# Bundled: redis://redis:6379/0
# External: redis://host:6379/0
REDIS_URL=redis://redis:6379/0

# --- Application ---
DEBUG=false
REGISTRATION_MODE=open
CAPTCHA_ENABLED=false
CORS_ORIGINS=["http://localhost:9933"]

# --- Recurring tasks (optional) ---
# Cadence of the Celery beat poller that materialises due recurring patterns.
# Defaults shown; uncomment to override.
# RECURRING_TASKS_BEAT_INTERVAL_SECONDS=3600
# RECURRING_TASKS_DEFAULT_LEAD_TIME_DAYS=30
# RECURRING_TASKS_MAX_LEAD_TIME_DAYS=90
# RECURRING_TASKS_BATCH_SIZE=100

# --- Plugins and imported passwords (optional) ---
# Plugins by dotted path; a plugin can add password hashers and import sources.
# INSTALLED_PLUGINS=["acme_import.Plugin"]
# Extra password hasher classes by dotted path, without a plugin.
# PASSWORD_HASHERS=["acme_hashers.AcmeTrackerMd5"]
# Imported password formats allowed to sign in (empty: none). Each account moves
# to a native bcrypt hash at its first sign-in.
# LEGACY_PASSWORD_ALGORITHMS=["redmine_sha1"]
# After this moment no imported password works and people use password recovery.
# LEGACY_PASSWORD_HASHES_EXPIRE_AT=2027-03-31T00:00:00Z

# --- Search and embeddings (optional) ---
# Semantic search runs a local model from SPECIVO_DATA_DIR/models; see the guide
# page "Semantic search and embeddings". CPU threads it may use (0 = all cores).
# EMBEDDING_ONNX_THREADS=2
# SEARCH_INDEX_COMMENTS=true
# SEARCH_MIN_COMMENT_LENGTH=20
# SEARCH_EXCLUDE_BOT_COMMENTS=true
# Semantic search through the vector index: pgvector's candidate list per index
# scan (higher = more accurate, slower), and nearest chunks fetched per wanted
# result before results the reader cannot see are filtered out.
# SEARCH_HNSW_EF_SEARCH=100
# SEARCH_SEMANTIC_OVERFETCH=4

# --- SMTP (optional) ---
# For Mailhog: SMTP_HOST=mailhog, SMTP_PORT=1025, SMTP_TLS=false
# For real mail: configure your SMTP server here.
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
