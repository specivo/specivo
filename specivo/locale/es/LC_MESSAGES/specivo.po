msgstr "El proveedor no anuncia PKCE. Specivo lo envía de todos modos (S256)."

#: specivo/templates/themes/default/pages/admin/sso_provider_detail.html:55
msgid ""
"Sign-out at the provider is on, but the provider has no "
"end_session_endpoint."
msgstr ""
"El cierre de sesión en el proveedor está activado, pero el proveedor no "
"tiene end_session_endpoint."

#: specivo/templates/themes/default/pages/admin/sso_provider_detail.html:56
msgid "Back-channel logout is on, but the provider does not support it."
msgstr ""
"El cierre de sesión por canal secundario está activado, pero el proveedor"
" no lo admite."

#: specivo/templates/themes/default/pages/admin/sso_provider_detail.html:57
msgid "Userinfo is on, but the provider has no userinfo_endpoint."
msgstr "Userinfo está activado, pero el proveedor no tiene userinfo_endpoint."

#: specivo/templates/themes/default/pages/admin/sso_provider_detail.html:58
msgid "The stored client secret cannot be read: enter it again."
msgstr "No se puede leer el secreto de cliente guardado: introdúcelo de nuevo."

#: specivo/templates/themes/default/pages/admin/sso_provider_detail.html:59
msgid "The client secret environment variable is not set."
msgstr "La variable de entorno del secreto de cliente no está definida."

#: specivo/templates/themes/default/pages/admin/sso_provider_detail.html:60
msgid "The client secret environment variable name is not allowed."
msgstr ""
"El nombre de la variable de entorno del secreto de cliente no está "
"permitido."

#: specivo/templates/themes/default/pages/admin/sso_provider_detail.html:61
