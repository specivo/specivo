msgstr "La dirección IP es demasiado larga."

#: specivo/web/pages/auth.py:211
msgid "No reset token provided. Please use the link from your email."
msgstr ""
"No se proporcionó ningún token de restablecimiento. Usa el enlace de tu "
"correo electrónico."

#: specivo/web/pages/auth.py:219
msgid "This password reset link is invalid. Please request a new one."
msgstr ""
"Este enlace de restablecimiento de contraseña no es válido. Solicita uno "
"nuevo."

#: specivo/web/pages/auth.py:221
msgid "This password reset link has already been used. Please request a new one."
msgstr ""
"Este enlace de restablecimiento de contraseña ya se ha utilizado. "
"Solicita uno nuevo."

#: specivo/web/pages/auth.py:223
msgid "This password reset link has expired. Please request a new one."
msgstr ""
"Este enlace de restablecimiento de contraseña ha caducado. Solicita uno "
"nuevo."

#: specivo/web/pages/connected_accounts.py:70
#, python-format
msgid "Your %(provider)s account is now connected."
msgstr "Tu cuenta de %(provider)s ya está conectada."

#: specivo/web/pages/connected_accounts.py:79
#, python-format
msgid "Your %(provider)s account was disconnected."
msgstr "Tu cuenta de %(provider)s se ha desconectado."

#: specivo/web/pages/email_change.py:57
msgid ""
"Check the inbox of the new address and open the link to confirm the "
"change. Your current address stays in use until then."
msgstr ""
"Revisa la bandeja de entrada de la nueva dirección y abre el enlace para "
"confirmar el cambio. Hasta entonces, tu dirección actual sigue en uso."

#: specivo/web/pages/email_change.py:60
msgid "A new link is on its way. Earlier links no longer work."
msgstr "Hay un enlace nuevo en camino. Los enlaces anteriores ya no funcionan."

#: specivo/web/pages/email_change.py:61
msgid "The email change was cancelled."
msgstr "Se ha cancelado el cambio de correo electrónico."

#: specivo/web/pages/email_change.py:89
msgid ""
"You signed in again. Request the email change within the next five "
"minutes."
msgstr ""
"Has vuelto a iniciar sesión. Solicita el cambio de correo electrónico en "
"los próximos cinco minutos."

#: specivo/web/pages/issues.py:195
msgid "Unknown person"
msgstr "Persona desconocida"

#: specivo/web/pages/issues.py:202
msgid "Unknown tag"
msgstr "Etiqueta desconocida"

#: specivo/web/pages/issues.py:209
msgid "Unknown release"
msgstr "Versión desconocida"

#: specivo/web/pages/sso.py:105
msgid "Your sign-in expired or was started in another browser. Please try again."
msgstr ""
"Tu inicio de sesión caducó o se inició en otro navegador. Inténtalo de "
"nuevo."

#: specivo/web/pages/sso.py:106
msgid "The identity provider refused the sign-in."
msgstr "El proveedor de identidad rechazó el inicio de sesión."

#: specivo/web/pages/sso.py:107
msgid "The identity provider is unavailable. Please try again later."
msgstr ""
"El proveedor de identidad no está disponible. Inténtalo de nuevo más "
"tarde."

#: specivo/web/pages/sso.py:108 specivo/web/pages/sso.py:109
msgid "Single sign-on is not configured correctly. Contact your administrator."
msgstr ""
"El inicio de sesión único no está configurado correctamente. Contacta con"
" tu administrador."

#: specivo/web/pages/sso.py:111
msgid ""
"No account here is connected to your identity provider account. Contact "
"your administrator."
msgstr ""
"Ninguna cuenta de este sitio está vinculada a tu cuenta del proveedor de "
"identidad. Contacta con tu administrador."

#: specivo/web/pages/sso.py:113
msgid "This account is disabled. Contact your administrator."
msgstr "Esta cuenta está desactivada. Contacta con tu administrador."

#: specivo/web/pages/sso.py:114
msgid "Single sign-on is temporarily unavailable. Please try again later."
msgstr ""
"El inicio de sesión único no está disponible temporalmente. Inténtalo de "
"nuevo más tarde."

#: specivo/web/pages/sso.py:115
msgid ""
"The identity provider did not send an email address. Contact your "
"administrator."
msgstr ""
"El proveedor de identidad no envió una dirección de correo electrónico. "
"Contacta con tu administrador."

#: specivo/web/pages/sso.py:117
msgid ""
"An account with this email address already exists. Sign in with your "
"password and connect the account from your profile."
msgstr ""
"Ya existe una cuenta con esta dirección de correo electrónico. Inicia "
"sesión con tu contraseña y conecta la cuenta desde tu perfil."

#: specivo/web/pages/sso.py:120
msgid "This identity provider account is already connected to another account."
msgstr "Esta cuenta del proveedor de identidad ya está conectada a otra cuenta."

#: specivo/web/pages/sso.py:121
msgid "An account at this identity provider is already connected to your profile."
msgstr "Ya hay una cuenta de este proveedor de identidad conectada a tu perfil."

#: specivo/web/pages/sso.py:122
msgid ""
"Your email domain is not allowed to sign in here. Contact your "
"administrator."
msgstr ""
"El dominio de su correo electrónico no puede iniciar sesión aquí. Póngase"
" en contacto con su administrador."

#: specivo/web/pages/sso.py:124
msgid ""
"Your identity provider account is not in a group that may sign in here. "
"Contact your administrator."
msgstr ""
"Su cuenta del proveedor de identidad no pertenece a ningún grupo que "
"pueda iniciar sesión aquí. Póngase en contacto con su administrador."

#: specivo/web/pages/sso.py:127
msgid ""
"Your identity provider sent too many groups to read. Ask your "
"administrator to send only the groups assigned to the application, or app"
" roles."
msgstr ""
"Su proveedor de identidad envió demasiados grupos para leerlos. Pida a su"
" administrador que envíe solo los grupos asignados a la aplicación, o "
"roles de aplicación."

#: specivo/web/pages/sso.py:131
msgid ""
"Sign in again with the identity provider account connected to your "
"profile, not another one."
msgstr ""
"Vuelve a iniciar sesión con la cuenta del proveedor de identidad "
"vinculada a tu perfil, no con otra."

#: specivo/web/pages/sso.py:134
msgid ""
"This is your only way to sign in. Set a password or connect another "
"account before disconnecting it."
msgstr ""
"Es tu única forma de iniciar sesión. Establece una contraseña o conecta "
"otra cuenta antes de desconectarla."

#: specivo/web/pages/sso.py:137
msgid "Single sign-on failed. Please try again."
msgstr "El inicio de sesión único falló. Inténtalo de nuevo."

#: specivo/web/partials/links.py:89
msgid "No wiki page, issue or comment mentions this issue yet."
msgstr ""
"Ninguna página wiki, incidencia o comentario menciona esta incidencia "
"todavía."

#: specivo/web/partials/links.py:99
msgid "No wiki page, issue or comment links here yet."
msgstr "Ninguna página wiki, incidencia o comentario enlaza aquí todavía."

#: specivo/templates/themes/default/pages/admin/settings.html
msgid "Let search engines index public pages"
msgstr "Permitir que los buscadores indexen las páginas públicas"

#: specivo/templates/themes/default/pages/admin/settings.html
msgid "Only pages anyone can read without an account are offered: the project list, and the project pages, issues and wiki pages of projects opted in to anonymous access while it is on. Everything else stays marked noindex. robots.txt and /sitemap.xml follow this setting."
msgstr "Solo se ofrecen las páginas que cualquiera puede leer sin una cuenta: la lista de proyectos y las páginas de proyecto, las incidencias y las páginas wiki de los proyectos abiertos al acceso anónimo mientras este está activado. Todo lo demás sigue marcado como noindex. robots.txt y /sitemap.xml siguen este ajuste."

