msgstr "[{issue_key}] Asignada a ti por {actor_name}"

#: specivo/core/notification_templates.py:23
#, python-brace-format
msgid "Updated by {actor_name}"
msgstr "Actualizada por {actor_name}"

#: specivo/core/notification_templates.py:24
#, python-brace-format
msgid "[{issue_key}] Updated by {actor_name}"
msgstr "[{issue_key}] Actualizada por {actor_name}"

#: specivo/core/notification_templates.py:27
#, python-brace-format
msgid "{actor_name} commented"
msgstr "{actor_name} comentó"

#: specivo/core/notification_templates.py:28
#, python-brace-format
msgid "[{issue_key}] {actor_name} commented"
msgstr "[{issue_key}] {actor_name} comentó"

#: specivo/core/notification_templates.py:31
msgid "Password reset request"
msgstr "Solicitud de restablecimiento de contraseña"

#: specivo/schemas/auth.py:97
msgid ""
"The project limit must be an object with a single \"projects\" list "
"naming 1 to 200 projects by key or id."
msgstr ""
"El límite de proyectos debe ser un objeto con una única lista "
"\"projects\" que indique de 1 a 200 proyectos por clave o id."

#: specivo/services/api_key_scope.py:165
msgid "This API key is limited to specific projects and cannot do this."
msgstr "Esta clave API está limitada a proyectos concretos y no puede hacer esto."

#: specivo/services/api_key_service.py:64
#: specivo/services/api_key_service.py:72
msgid "Client IP not allowed by key allowlist"
msgstr "La IP del cliente no está permitida por la lista de IP de la clave"

#: specivo/services/api_key_service.py:94
msgid ""
"API keys are turned off for accounts that sign in through single sign-on."
" Ask an administrator if you need one."
msgstr ""
"Las claves API están desactivadas para las cuentas que inician sesión con"
" inicio de sesión único. Pida una a un administrador si la necesita."

#: specivo/services/api_key_service.py:161
#, python-brace-format
msgid ""
"This account has reached the limit of {limit} API keys. Delete keys it no"
" longer needs."
msgstr ""
"Esta cuenta ha alcanzado el límite de {limit} claves API. Elimina las "
"claves que ya no necesite."

#: specivo/services/api_key_service.py:201
#, python-brace-format
msgid "There is no project \"{project}\" that this key can be limited to."
msgstr "No hay ningún proyecto \"{project}\" al que se pueda limitar esta clave."

#: specivo/services/api_key_service.py:230
#: specivo/services/api_key_service.py:260
msgid "Invalid API key"
msgstr "Clave API no válida"

#: specivo/services/api_key_service.py:239
msgid "API key is inactive"
msgstr "La clave API está inactiva"

#: specivo/services/api_key_service.py:246
msgid "API key has expired"
msgstr "La clave API ha caducado"

#: specivo/services/api_key_service.py:301
#: specivo/services/api_key_service.py:330
msgid "API key not found"
msgstr "Clave API no encontrada"

#: specivo/services/auth_service.py:225 specivo/services/auth_service.py:246
#: specivo/services/auth_service.py:278
msgid "Invalid login or password"
msgstr "Usuario o contraseña no válidos"

#: specivo/services/auth_service.py:250
msgid "Email address not verified"
msgstr "La dirección de correo electrónico no está verificada"

#: specivo/services/auth_service.py:252
msgid "Account has been deactivated"
msgstr "La cuenta ha sido desactivada"

#: specivo/services/auth_service.py:256
msgid "Service accounts cannot log in. Use an API key instead."
msgstr ""
"Las cuentas de servicio no pueden iniciar sesión. Usa una clave API en su"
" lugar."

#: specivo/services/auth_service.py:262
msgid "Account is temporarily locked due to too many failed login attempts"
msgstr ""
"La cuenta está bloqueada temporalmente debido a demasiados intentos "
"fallidos de inicio de sesión"

#: specivo/services/auth_service.py:296
msgid "Account is locked. Contact an administrator."
msgstr "La cuenta está bloqueada. Contacta a un administrador."

#: specivo/services/auth_service.py:425
msgid "Refresh token expired or revoked"
msgstr "El token de actualización ha caducado o ha sido revocado"

#: specivo/services/auth_service.py:715
msgid "Session not found"
msgstr "Sesión no encontrada"

#: specivo/services/auth_service.py:811 specivo/services/auth_service.py:840
msgid "Invalid or expired password reset link"
msgstr "Enlace de restablecimiento de contraseña no válido o caducado"

#: specivo/services/auth_service.py:819
msgid "This password reset link has already been used"
msgstr "Este enlace de restablecimiento de contraseña ya se ha utilizado"

#: specivo/services/auth_service.py:827
msgid "This password reset link has expired"
msgstr "Este enlace de restablecimiento de contraseña ha caducado"

#: specivo/services/auth_service.py:899
msgid "This account has no password. It authenticates with an API key."
msgstr "Esta cuenta no tiene contraseña. Se autentica con una clave API."

#: specivo/services/auth_service.py:906
msgid ""
"This account has no password. You sign in through your identity provider,"
" so there is no password to change here."
msgstr ""
"Esta cuenta no tiene contraseña. Inicia sesión a través de su proveedor "
"de identidad, así que aquí no hay contraseña que cambiar."

#: specivo/services/auth_service.py:917
#: specivo/services/email_change_service.py:183
msgid "Current password is incorrect"
msgstr "La contraseña actual es incorrecta"

#: specivo/services/auth_service.py:927
#: specivo/templates/themes/default/pages/auth/_change_password_form.html:23
msgid "The new password must be different from the current one"
msgstr "La nueva contraseña debe ser distinta de la actual"

#: specivo/services/auth_utils.py:239
#: specivo/templates/themes/default/pages/auth/_change_password_form.html:21
#, python-format
msgid "Password must be at least %(count)d characters"
msgstr "La contraseña debe tener al menos %(count)d caracteres"

#: specivo/services/email_change_service.py:176
msgid "This account cannot change its email address here."
msgstr "Esta cuenta no puede cambiar su dirección de correo electrónico aquí."

#: specivo/services/email_change_service.py:178
#: specivo/templates/themes/default/pages/auth/profile.html:145
msgid ""
"Your email address is managed by your identity provider. Change it at "
"your identity provider."
msgstr ""
"Tu dirección de correo electrónico la gestiona tu proveedor de identidad."
" Cámbiala en tu proveedor de identidad."

#: specivo/services/email_change_service.py:181
msgid ""
"Sign in again with your identity provider, then request the change within"
" five minutes."
msgstr ""
"Vuelve a iniciar sesión con tu proveedor de identidad y solicita el "
"cambio en los cinco minutos siguientes."

#: specivo/services/email_change_service.py:184 specivo/web/pages/admin.py:248
msgid "Enter a valid email address."
msgstr "Introduce una dirección de correo electrónico válida."

#: specivo/services/email_change_service.py:185
msgid "This is already your email address."
msgstr "Esta ya es tu dirección de correo electrónico."

#: specivo/services/email_change_service.py:186
msgid "There is no pending email change."
msgstr "No hay ningún cambio de correo electrónico pendiente."

#: specivo/services/email_change_service.py:187
msgid "Too many email change requests. Please try again later."
msgstr ""
"Demasiadas solicitudes de cambio de correo electrónico. Inténtalo de "
"nuevo más tarde."

#: specivo/services/email_change_service.py:188
msgid "This confirmation link is not valid."
msgstr "Este enlace de confirmación no es válido."

#: specivo/services/email_change_service.py:189
msgid "This confirmation link has already been used."
msgstr "Este enlace de confirmación ya se ha utilizado."

#: specivo/services/email_change_service.py:191
msgid ""
"This confirmation link is no longer valid. Use the most recent link, or "
"request the change again."
msgstr ""
"Este enlace de confirmación ya no es válido. Usa el enlace más reciente o"
" vuelve a solicitar el cambio."

#: specivo/services/email_change_service.py:193
msgid "This confirmation link has expired. Request the change again."
msgstr "Este enlace de confirmación ha caducado. Vuelve a solicitar el cambio."

#: specivo/services/email_change_service.py:195
msgid ""
"This email address is now used by another account. Your address was not "
"changed."
msgstr ""
"Esta dirección de correo electrónico la usa ahora otra cuenta. Tu "
"dirección no se ha cambiado."

#: specivo/services/email_change_service.py:198
msgid "The email address could not be changed. Please try again."
msgstr "No se pudo cambiar la dirección de correo electrónico. Inténtalo de nuevo."

#: specivo/services/email_change_service.py:284
#, python-format
msgid "Hi %(name)s,"
msgstr "Hola, %(name)s:"

#: specivo/services/email_change_service.py:539
#, python-format
msgid "Confirm your new email address for %(brand)s"
msgstr "Confirma tu nueva dirección de correo electrónico para %(brand)s"

#: specivo/services/email_change_service.py:543
#, python-format
msgid ""
"Someone, hopefully you, asked to use this address for the %(brand)s "
"account %(login)s. Confirm the change to make it the account's email "
"address."
msgstr ""
"Alguien, esperemos que tú, ha pedido usar esta dirección para la cuenta "
"%(login)s de %(brand)s. Confirma el cambio para que pase a ser la "
"dirección de correo electrónico de la cuenta."

#: specivo/services/email_change_service.py:548
#, python-format
msgid ""
"This link expires in %(hours)s hours. Only the most recent link works. "
"Until you confirm, the account keeps its current address."
msgstr ""
"Este enlace caduca en %(hours)s horas. Solo funciona el enlace más "
"reciente. Hasta que lo confirmes, la cuenta conserva su dirección actual."

#: specivo/services/email_change_service.py:552
msgid "If you did not ask for this, ignore this email. Nothing changes."
msgstr "Si no lo has pedido tú, ignora este correo. No cambiará nada."

#: specivo/services/email_change_service.py:555
#: specivo/templates/themes/default/pages/auth/confirm_email.html:3
#: specivo/templates/themes/default/pages/auth/confirm_email.html:16
#: specivo/templates/themes/default/pages/auth/confirm_email.html:48
msgid "Confirm email address"
msgstr "Confirmar dirección de correo electrónico"

#: specivo/services/email_change_service.py:562
#, python-format
msgid "Someone tried to use your email address on %(brand)s"
msgstr "Alguien ha intentado usar tu dirección de correo electrónico en %(brand)s"

#: specivo/services/email_change_service.py:566
#, python-format
msgid ""
"Someone tried to use this address for another %(brand)s account. This "
"address already belongs to your account, so nothing was changed."
msgstr ""
"Alguien ha intentado usar esta dirección para otra cuenta de %(brand)s. "
"Esta dirección ya pertenece a tu cuenta, así que no se ha cambiado nada."

#: specivo/services/email_change_service.py:571
msgid ""
"If it was you, sign in to the account that already uses this address. If "
"you have forgotten its password, reset it here:"
msgstr ""
"Si has sido tú, inicia sesión en la cuenta que ya usa esta dirección. Si "
"has olvidado su contraseña, restablécela aquí:"

#: specivo/services/email_change_service.py:574
msgid "If you do not recognise this, you can ignore this email."
msgstr "Si no reconoces esta acción, puedes ignorar este correo."

#: specivo/services/email_change_service.py:577
#: specivo/services/email_change_service.py:714
msgid "Reset password"
msgstr "Restablecer contraseña"

#: specivo/services/email_change_service.py:701
#: specivo/services/email_change_service.py:779
#, python-format
msgid "Your %(brand)s email address was changed"
msgstr "Se ha cambiado tu dirección de correo electrónico de %(brand)s"

#: specivo/services/email_change_service.py:704
#, python-format
msgid "Your %(brand)s email was changed to %(address)s."
msgstr "Tu correo electrónico de %(brand)s se ha cambiado a %(address)s."

#: specivo/services/email_change_service.py:707
#, python-format
msgid ""
"If you did not do this, reset your password straight away and contact an "
"administrator of %(brand)s. Password reset emails now go to the new "
"address, so an administrator may have to restore your address first."
msgstr ""
"Si no lo has hecho tú, restablece tu contraseña de inmediato y ponte en "
"contacto con un administrador de %(brand)s. Los correos para restablecer "
"la contraseña ahora llegan a la nueva dirección, por lo que puede que un "
"administrador tenga que restaurar primero tu dirección."

#: specivo/services/email_change_service.py:752
#: specivo/services/email_change_service.py:763 specivo/web/pages/admin.py:250
msgid "A user with this email already exists"
msgstr "Ya existe un usuario con este correo electrónico"

#: specivo/services/email_change_service.py:783
#, python-format
msgid ""
"An administrator changed the email address of your %(brand)s account "
"%(login)s to %(address)s."
msgstr ""
"Un administrador ha cambiado la dirección de correo electrónico de tu "
"cuenta %(login)s de %(brand)s a %(address)s."

#: specivo/services/email_change_service.py:787
#, python-format
msgid "If you did not expect this, contact an administrator of %(brand)s."
msgstr "Si no lo esperabas, ponte en contacto con un administrador de %(brand)s."

#: specivo/services/issue_service.py:98
msgid "No issue statuses found; run seed data first"
msgstr ""
"No se encontraron estados de incidencia; ejecuta primero los datos "
"iniciales"

#: specivo/services/issue_service.py:138
msgid "You do not have permission to set issue privacy"
msgstr "No tienes permiso para cambiar la privacidad de las incidencias"

#: specivo/services/issue_service.py:140
msgid ""
"Issues of this tracker are private by default; you do not have permission"
" to change that"
msgstr ""
"Las incidencias de este tipo de seguimiento son privadas por defecto; no "
"tienes permiso para cambiarlo"

#: specivo/services/issue_service.py:160
msgid "No issue priorities found; run seed data first"
msgstr ""
"No se encontraron prioridades de incidencia; ejecuta primero los datos "
"iniciales"

#: specivo/services/issue_service.py:180
#, python-format
msgid "Version %(id)s not found"
msgstr "Versión %(id)s no encontrada"

#: specivo/services/issue_service.py:186
msgid "Version does not belong to this project"
msgstr "La versión no pertenece a este proyecto"

#: specivo/services/issue_service.py:192
#, python-format
msgid "Cannot assign issues to a %(status)s version"
msgstr "No se pueden asignar incidencias a una versión %(status)s"

#: specivo/services/issue_service.py:211
#, python-format
msgid "Sprint %(id)s not found"
msgstr "Sprint %(id)s no encontrado"

#: specivo/services/issue_service.py:217
msgid "Sprint does not belong to this project"
msgstr "El sprint no pertenece a este proyecto"

#: specivo/services/issue_service.py:223
msgid "Cannot assign issues to a completed sprint"
msgstr "No se pueden asignar incidencias a un sprint completado"

#: specivo/services/issue_service.py:1006
#: specivo/services/sprint_service.py:307
msgid "Issue was modified by another request. Reload and retry."
msgstr ""
"La incidencia fue modificada por otra solicitud. Recarga e inténtalo de "
"nuevo."

#: specivo/services/issue_service.py:1169
msgid "Issue is already in this project."
msgstr "La incidencia ya está en este proyecto."

#: specivo/services/issue_service.py:1178
msgid ""
"Cannot move an issue that is part of a hierarchy. Detach it from its "
"parent and move or detach its children first."
msgstr ""
"No se puede mover una incidencia que forma parte de una jerarquía. "
"Sepárala de su incidencia padre y mueve o separa primero sus incidencias "
"hijas."

#: specivo/services/issue_service.py:1229
#, python-brace-format
msgid "Moved from {old} to {new}."
msgstr "Movida de {old} a {new}."

#: specivo/services/issue_service.py:1303
#, python-brace-format
msgid ""
"Unknown status filter '{value}'. Use 'open', 'closed', 'all', a status "
"id, or one of: {known}"
msgstr ""
"Filtro de estado desconocido '{value}'. Usa 'open', 'closed', 'all', un "
"id de estado o uno de: {known}"

#: specivo/services/journal_service.py:311
msgid "The history entry does not belong to this issue."
msgstr "La entrada del historial no pertenece a esta incidencia."

#: specivo/services/journal_service.py:462
msgid "Cannot reply to a journal on a different issue"
msgstr "No se puede responder a un registro de otra incidencia"

#: specivo/services/markdown_budget.py:126
#, python-brace-format
msgid "Text is too long ({length} characters); the limit is {limit}."
msgstr "El texto es demasiado largo ({length} caracteres); el límite es {limit}."

#: specivo/services/markdown_service.py:248
msgid "This text is too complex to format, so it is shown as plain text."
msgstr ""
"Este texto es demasiado complejo para darle formato, así que se muestra "
"como texto sin formato."

#: specivo/services/metadata_schema_service.py:53
#, python-brace-format
msgid "Invalid JSON Schema: {reason}"
msgstr "JSON Schema no válido: {reason}"

#: specivo/services/metadata_schema_service.py:147
#, python-brace-format
msgid "Metadata does not match schema '{schema}': {reason}"
msgstr "Los metadatos no cumplen el esquema '{schema}': {reason}"

#: specivo/services/metadata_schema_service.py:151
#, python-brace-format
msgid "Metadata field '{key}' does not match schema '{schema}': {reason}"
msgstr "El campo de metadatos '{key}' no cumple el esquema '{schema}': {reason}"

#: specivo/services/nested_set_service.py:40
#, python-format
msgid ""
"Hierarchy depth limit exceeded: with this parent the hierarchy, sub-tasks"
" included, would be %(levels)s levels deep, and at most %(max)s are "
"allowed."
msgstr ""
"Se ha superado el límite de profundidad de la jerarquía: con este padre "
"la jerarquía, incluidas las subtareas, tendría %(levels)s niveles de "
"profundidad, y se permiten como máximo %(max)s."

#: specivo/services/recurring_pattern_service.py:252
#: specivo/templates/themes/default/pages/projects/recurring_pattern_form.html:31
msgid "This pattern was changed by someone else. Reload and try again."
msgstr ""
"Este patrón fue modificado por otra persona. Vuelva a cargar e inténtelo "
"de nuevo."

#: specivo/services/scim/config_service.py:102
msgid "Generate a SCIM token before turning provisioning on."
msgstr "Genera un token SCIM antes de activar el aprovisionamiento."

#: specivo/services/sprint_service.py:270
msgid "Cannot move issues to the sprint being completed"
msgstr "No se pueden mover incidencias al sprint que se está completando"

#: specivo/services/user_service.py:73 specivo/web/pages/admin.py:247
msgid ""
"This is the last active administrator. Make another user an administrator"
" first."
msgstr ""
"Este es el último administrador activo. Primero convierta a otro usuario "
"en administrador."

#: specivo/services/workflow_service.py:224
msgid "No project roles found for user"
msgstr "No se encontraron roles de proyecto para el usuario"

#: specivo/services/workflow_service.py:234
#, python-brace-format
msgid "Transition from status {old} to {new} is not allowed"
msgstr "No se permite la transición del estado {old} al estado {new}"

#: specivo/services/workflow_service.py:301
#, python-brace-format
msgid "Field '{field}' is required for this status"
msgstr "El campo '{field}' es obligatorio para este estado"

#: specivo/services/workflow_service.py:308
#, python-brace-format
msgid "Field '{field}' is read-only for this status"
msgstr "El campo '{field}' es de solo lectura para este estado"

#: specivo/services/workflow_service.py:366
msgid "Duplicate workflow transition"
msgstr "Transición de flujo de trabajo duplicada"

#: specivo/services/workflow_service.py:379
msgid "Workflow transition not found"
msgstr "Transición de flujo de trabajo no encontrada"

#: specivo/services/workflow_service.py:447
msgid "Duplicate workflow field rule"
msgstr "Regla de campo de flujo de trabajo duplicada"

#: specivo/services/workflow_service.py:459
msgid "Workflow field rule not found"
msgstr "Regla de campo de flujo de trabajo no encontrada"

#: specivo/templates/themes/default/base.html:18
msgid "This diagram could not be drawn. Its source is shown below."
msgstr ""
"No se pudo dibujar este diagrama. Su código fuente se muestra a "
"continuación."

#: specivo/templates/themes/default/base.html:39
msgid "You are reading a public project. Sign in to take part."
msgstr "Estás leyendo un proyecto público. Inicia sesión para participar."

#: specivo/templates/themes/default/base.html:40
#: specivo/templates/themes/default/components/header.html:143
#: specivo/templates/themes/default/pages/auth/login.html:3
#: specivo/templates/themes/default/pages/auth/login.html:67
#: specivo/templates/themes/default/pages/auth/login.html:157
msgid "Sign in"
msgstr "Iniciar sesión"

#: specivo/templates/themes/default/base.html:45
msgid "Powered by"
msgstr "Con tecnología de"

#: specivo/templates/themes/default/components/app_url_warning.html:18
msgid "This page is open under another address than APP_URL"
msgstr "Esta página está abierta con una dirección distinta de APP_URL"

#: specivo/templates/themes/default/components/app_url_warning.html:19
#, python-format
msgid ""
"The URLs below are built from the APP_URL setting, "
"<code>%(app_url)s</code>, but this page was opened at "
"<code>%(host)s</code>. If that is the address others use to reach "
"Specivo, set APP_URL to it, or the URLs you copy may not reach this "
"instance."
msgstr ""
"Las URL de abajo se construyen a partir del ajuste APP_URL, "
"<code>%(app_url)s</code>, pero esta página se abrió en "
"<code>%(host)s</code>. Si esa es la dirección que otros usan para acceder"
" a Specivo, pon APP_URL en ella; si no, las URL que copies podrían no "
"llegar a esta instancia."

#: specivo/templates/themes/default/components/app_url_warning.html:21
msgid "APP_URL points at this machine"
msgstr "APP_URL apunta a esta máquina"

#: specivo/templates/themes/default/components/app_url_warning.html:22
#, python-format
msgid ""
"The URLs below are built from the APP_URL setting, which is "
"<code>%(app_url)s</code>. A forge or an identity provider cannot reach "
"that address. Set APP_URL to the public address of Specivo and restart it"
" before you copy them."
msgstr ""
"Las URL de abajo se construyen a partir del ajuste APP_URL, que es "
"<code>%(app_url)s</code>. Ni una forja ni un proveedor de identidad "
"pueden alcanzar esa dirección. Pon en APP_URL la dirección pública de "
"Specivo y reinícialo antes de copiarlas."

#: specivo/templates/themes/default/components/app_url_warning.html:24
msgid "How to set APP_URL"
msgstr "Cómo configurar APP_URL"

#: specivo/templates/themes/default/components/filter_combobox.html:28
#: specivo/templates/themes/default/components/filter_combobox.html:29
#, python-format
msgid "Clear the %(field)s filter"
msgstr "Quitar el filtro «%(field)s»"

#: specivo/templates/themes/default/components/filter_combobox.html:91
#: specivo/templates/themes/default/pages/search.html:120
msgid "Searching…"
msgstr "Buscando…"

#: specivo/templates/themes/default/components/filter_combobox.html:92
#: specivo/templates/themes/default/pages/issues/_sidebar.html:142
#: specivo/templates/themes/default/pages/issues/_sidebar.html:187
