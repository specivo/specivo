#: specivo/api/v1/attachments.py:94
msgid "You do not have permission to add files here."
msgstr "คุณไม่มีสิทธิ์เพิ่มไฟล์ที่นี่"

#: specivo/api/v1/attachments.py:171 specivo/api/v1/attachments.py:194
msgid "You do not have permission to change this file."
msgstr "คุณไม่มีสิทธิ์เปลี่ยนแปลงไฟล์นี้"

#: specivo/core/notification_templates.py:19
#, python-brace-format
msgid "Assigned to you by {actor_name}"
msgstr "มอบหมายให้คุณโดย {actor_name}"

#: specivo/core/notification_templates.py:20
#, python-brace-format
msgid "[{issue_key}] Assigned to you by {actor_name}"
msgstr "[{issue_key}] มอบหมายให้คุณโดย {actor_name}"

#: specivo/core/notification_templates.py:23
#, python-brace-format
msgid "Updated by {actor_name}"
msgstr "อัปเดตโดย {actor_name}"

#: specivo/core/notification_templates.py:24
#, python-brace-format
msgid "[{issue_key}] Updated by {actor_name}"
msgstr "[{issue_key}] อัปเดตโดย {actor_name}"

#: specivo/core/notification_templates.py:27
#, python-brace-format
msgid "{actor_name} commented"
msgstr "{actor_name} แสดงความคิดเห็น"

#: specivo/core/notification_templates.py:28
#, python-brace-format
msgid "[{issue_key}] {actor_name} commented"
msgstr "[{issue_key}] {actor_name} แสดงความคิดเห็น"

#: specivo/core/notification_templates.py:31
msgid "Password reset request"
msgstr "คำขอรีเซ็ตรหัสผ่าน"

#: specivo/schemas/auth.py:97
msgid ""
"The project limit must be an object with a single \"projects\" list "
"naming 1 to 200 projects by key or id."
msgstr ""
"ขีดจำกัดโปรเจกต์ต้องเป็นออบเจกต์ที่มีรายการ \"projects\" เพียงรายการเดียว"
" ซึ่งระบุโปรเจกต์ 1 ถึง 200 รายการด้วยคีย์หรือ id"

#: specivo/services/api_key_scope.py:165
msgid "This API key is limited to specific projects and cannot do this."
msgstr "คีย์ API นี้จำกัดไว้เฉพาะบางโปรเจกต์และไม่สามารถทำสิ่งนี้ได้"

#: specivo/services/api_key_service.py:64
#: specivo/services/api_key_service.py:72
msgid "Client IP not allowed by key allowlist"
msgstr "IP ของคุณไม่อยู่ในรายการที่อนุญาตของ API key"

#: specivo/services/api_key_service.py:94
msgid ""
"API keys are turned off for accounts that sign in through single sign-on."
" Ask an administrator if you need one."
msgstr ""
"คีย์ API ถูกปิดสำหรับบัญชีที่ลงชื่อเข้าใช้ผ่านการลงชื่อเข้าใช้ครั้งเดียว "
"(SSO) หากต้องการคีย์ โปรดติดต่อผู้ดูแลระบบ"

#: specivo/services/api_key_service.py:161
#, python-brace-format
msgid ""
"This account has reached the limit of {limit} API keys. Delete keys it no"
" longer needs."
msgstr ""
"บัญชีนี้มีคีย์ API ครบขีดจำกัด {limit} คีย์แล้ว "
"โปรดลบคีย์ที่ไม่ต้องใช้แล้ว"

#: specivo/services/api_key_service.py:201
#, python-brace-format
msgid "There is no project \"{project}\" that this key can be limited to."
msgstr "ไม่มีโปรเจกต์ \"{project}\" ที่จะจำกัดคีย์นี้ได้"

#: specivo/services/api_key_service.py:230
#: specivo/services/api_key_service.py:260
msgid "Invalid API key"
msgstr "API key ไม่ถูกต้อง"

#: specivo/services/api_key_service.py:239
msgid "API key is inactive"
msgstr "API key ถูกปิดใช้งานแล้ว"

#: specivo/services/api_key_service.py:246
msgid "API key has expired"
msgstr "API key หมดอายุแล้ว"

#: specivo/services/api_key_service.py:301
#: specivo/services/api_key_service.py:330
msgid "API key not found"
msgstr "ไม่พบ API key"

#: specivo/services/auth_service.py:225 specivo/services/auth_service.py:246
#: specivo/services/auth_service.py:278
msgid "Invalid login or password"
msgstr "ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง"

#: specivo/services/auth_service.py:250
msgid "Email address not verified"
msgstr "อีเมลยังไม่ได้รับการยืนยัน"

#: specivo/services/auth_service.py:252
msgid "Account has been deactivated"
msgstr "บัญชีถูกปิดใช้งานแล้ว"

#: specivo/services/auth_service.py:256
msgid "Service accounts cannot log in. Use an API key instead."
msgstr "บัญชีบริการไม่สามารถเข้าสู่ระบบได้ กรุณาใช้ API key แทน"

#: specivo/services/auth_service.py:262
msgid "Account is temporarily locked due to too many failed login attempts"
msgstr "บัญชีถูกล็อกชั่วคราวเนื่องจากเข้าสู่ระบบผิดพลาดหลายครั้ง"

#: specivo/services/auth_service.py:296
msgid "Account is locked. Contact an administrator."
msgstr "บัญชีถูกล็อก กรุณาติดต่อผู้ดูแลระบบ"

#: specivo/services/auth_service.py:425
msgid "Refresh token expired or revoked"
msgstr "โทเค็นรีเฟรชหมดอายุหรือถูกเพิกถอน"

#: specivo/services/auth_service.py:715
msgid "Session not found"
msgstr "ไม่พบเซสชัน"

#: specivo/services/auth_service.py:811 specivo/services/auth_service.py:840
msgid "Invalid or expired password reset link"
msgstr "ลิงก์รีเซ็ตรหัสผ่านไม่ถูกต้องหรือหมดอายุแล้ว"

#: specivo/services/auth_service.py:819
msgid "This password reset link has already been used"
msgstr "ลิงก์รีเซ็ตรหัสผ่านนี้ถูกใช้งานไปแล้ว"

#: specivo/services/auth_service.py:827
msgid "This password reset link has expired"
msgstr "ลิงก์รีเซ็ตรหัสผ่านนี้หมดอายุแล้ว"

#: specivo/services/auth_service.py:899
msgid "This account has no password. It authenticates with an API key."
msgstr "บัญชีนี้ไม่มีรหัสผ่าน ใช้ API key ในการยืนยันตัวตน"

#: specivo/services/auth_service.py:906
msgid ""
"This account has no password. You sign in through your identity provider,"
" so there is no password to change here."
msgstr ""
"บัญชีนี้ไม่มีรหัสผ่าน คุณลงชื่อเข้าใช้ผ่านผู้ให้บริการข้อมูลประจำตัว "
"จึงไม่มีรหัสผ่านให้เปลี่ยนที่นี่"

#: specivo/services/auth_service.py:917
#: specivo/services/email_change_service.py:183
msgid "Current password is incorrect"
msgstr "รหัสผ่านปัจจุบันไม่ถูกต้อง"

#: specivo/services/auth_service.py:927
#: specivo/templates/themes/default/pages/auth/_change_password_form.html:23
msgid "The new password must be different from the current one"
msgstr "รหัสผ่านใหม่ต้องไม่ซ้ำกับรหัสผ่านปัจจุบัน"

#: specivo/services/auth_utils.py:239
#: specivo/templates/themes/default/pages/auth/_change_password_form.html:21
#, python-format
msgid "Password must be at least %(count)d characters"
msgstr "รหัสผ่านต้องมีอย่างน้อย %(count)d ตัวอักษร"

#: specivo/services/email_change_service.py:176
msgid "This account cannot change its email address here."
msgstr "บัญชีนี้ไม่สามารถเปลี่ยนที่อยู่อีเมลที่นี่ได้"

#: specivo/services/email_change_service.py:178
#: specivo/templates/themes/default/pages/auth/profile.html:145
msgid ""
"Your email address is managed by your identity provider. Change it at "
"your identity provider."
msgstr ""
"ที่อยู่อีเมลของคุณจัดการโดยผู้ให้บริการข้อมูลประจำตัว "
"โปรดเปลี่ยนที่ผู้ให้บริการข้อมูลประจำตัวของคุณ"

#: specivo/services/email_change_service.py:181
msgid ""
"Sign in again with your identity provider, then request the change within"
" five minutes."
msgstr "ลงชื่อเข้าใช้ใหม่ผ่านผู้ให้บริการข้อมูลประจำตัว แล้วขอเปลี่ยนภายในห้านาที"

#: specivo/services/email_change_service.py:184 specivo/web/pages/admin.py:248
msgid "Enter a valid email address."
msgstr "กรอกที่อยู่อีเมลที่ถูกต้อง"

#: specivo/services/email_change_service.py:185
msgid "This is already your email address."
msgstr "นี่คือที่อยู่อีเมลของคุณอยู่แล้ว"

#: specivo/services/email_change_service.py:186
msgid "There is no pending email change."
msgstr "ไม่มีการเปลี่ยนอีเมลที่รอดำเนินการ"

#: specivo/services/email_change_service.py:187
msgid "Too many email change requests. Please try again later."
msgstr "มีคำขอเปลี่ยนอีเมลมากเกินไป โปรดลองอีกครั้งในภายหลัง"

#: specivo/services/email_change_service.py:188
msgid "This confirmation link is not valid."
msgstr "ลิงก์ยืนยันนี้ไม่ถูกต้อง"

#: specivo/services/email_change_service.py:189
msgid "This confirmation link has already been used."
msgstr "ลิงก์ยืนยันนี้ถูกใช้ไปแล้ว"

#: specivo/services/email_change_service.py:191
msgid ""
"This confirmation link is no longer valid. Use the most recent link, or "
"request the change again."
msgstr "ลิงก์ยืนยันนี้ใช้ไม่ได้แล้ว โปรดใช้ลิงก์ล่าสุด หรือขอเปลี่ยนอีกครั้ง"

#: specivo/services/email_change_service.py:193
msgid "This confirmation link has expired. Request the change again."
msgstr "ลิงก์ยืนยันนี้หมดอายุแล้ว โปรดขอเปลี่ยนอีกครั้ง"

#: specivo/services/email_change_service.py:195
msgid ""
"This email address is now used by another account. Your address was not "
"changed."
msgstr "ที่อยู่อีเมลนี้ถูกใช้โดยบัญชีอื่นแล้ว ที่อยู่ของคุณไม่ได้ถูกเปลี่ยน"

#: specivo/services/email_change_service.py:198
msgid "The email address could not be changed. Please try again."
msgstr "ไม่สามารถเปลี่ยนที่อยู่อีเมลได้ โปรดลองอีกครั้ง"

#: specivo/services/email_change_service.py:284
#, python-format
msgid "Hi %(name)s,"
msgstr "สวัสดี %(name)s"

#: specivo/services/email_change_service.py:539
#, python-format
msgid "Confirm your new email address for %(brand)s"
msgstr "ยืนยันที่อยู่อีเมลใหม่ของคุณสำหรับ %(brand)s"

#: specivo/services/email_change_service.py:543
#, python-format
msgid ""
"Someone, hopefully you, asked to use this address for the %(brand)s "
"account %(login)s. Confirm the change to make it the account's email "
"address."
msgstr ""
"มีผู้ขอใช้ที่อยู่นี้สำหรับบัญชี %(login)s ของ %(brand)s "
"(หวังว่าจะเป็นคุณ) โปรดยืนยันการเปลี่ยนเพื่อให้เป็นที่อยู่อีเมลของบัญชี"

#: specivo/services/email_change_service.py:548
#, python-format
msgid ""
"This link expires in %(hours)s hours. Only the most recent link works. "
"Until you confirm, the account keeps its current address."
msgstr ""
"ลิงก์นี้หมดอายุใน %(hours)s ชั่วโมง ใช้ได้เฉพาะลิงก์ล่าสุดเท่านั้น "
"จนกว่าคุณจะยืนยัน บัญชีจะยังใช้ที่อยู่ปัจจุบัน"

#: specivo/services/email_change_service.py:552
msgid "If you did not ask for this, ignore this email. Nothing changes."
msgstr "หากคุณไม่ได้ขอ โปรดละเว้นอีเมลนี้ จะไม่มีอะไรเปลี่ยนแปลง"

#: specivo/services/email_change_service.py:555
#: specivo/templates/themes/default/pages/auth/confirm_email.html:3
#: specivo/templates/themes/default/pages/auth/confirm_email.html:16
#: specivo/templates/themes/default/pages/auth/confirm_email.html:48
msgid "Confirm email address"
msgstr "ยืนยันที่อยู่อีเมล"

#: specivo/services/email_change_service.py:562
#, python-format
msgid "Someone tried to use your email address on %(brand)s"
msgstr "มีผู้พยายามใช้ที่อยู่อีเมลของคุณใน %(brand)s"

#: specivo/services/email_change_service.py:566
#, python-format
msgid ""
"Someone tried to use this address for another %(brand)s account. This "
"address already belongs to your account, so nothing was changed."
msgstr ""
"มีผู้พยายามใช้ที่อยู่นี้สำหรับบัญชีอื่นใน %(brand)s "
"ที่อยู่นี้เป็นของบัญชีคุณอยู่แล้ว จึงไม่มีการเปลี่ยนแปลงใด ๆ"

#: specivo/services/email_change_service.py:571
msgid ""
"If it was you, sign in to the account that already uses this address. If "
"you have forgotten its password, reset it here:"
msgstr ""
"หากเป็นคุณ โปรดลงชื่อเข้าใช้บัญชีที่ใช้ที่อยู่นี้อยู่แล้ว หากลืมรหัสผ่าน "
"รีเซ็ตได้ที่นี่:"

#: specivo/services/email_change_service.py:574
msgid "If you do not recognise this, you can ignore this email."
msgstr "หากคุณไม่ทราบเรื่องนี้ สามารถละเว้นอีเมลนี้ได้"

#: specivo/services/email_change_service.py:577
#: specivo/services/email_change_service.py:714
msgid "Reset password"
msgstr "รีเซ็ตรหัสผ่าน"

#: specivo/services/email_change_service.py:701
#: specivo/services/email_change_service.py:779
#, python-format
msgid "Your %(brand)s email address was changed"
msgstr "ที่อยู่อีเมล %(brand)s ของคุณถูกเปลี่ยนแล้ว"

#: specivo/services/email_change_service.py:704
#, python-format
msgid "Your %(brand)s email was changed to %(address)s."
msgstr "อีเมล %(brand)s ของคุณถูกเปลี่ยนเป็น %(address)s แล้ว"

#: specivo/services/email_change_service.py:707
#, python-format
msgid ""
"If you did not do this, reset your password straight away and contact an "
"administrator of %(brand)s. Password reset emails now go to the new "
"address, so an administrator may have to restore your address first."
msgstr ""
"หากคุณไม่ได้ทำ โปรดรีเซ็ตรหัสผ่านทันทีและติดต่อผู้ดูแลระบบของ %(brand)s "
"ตอนนี้อีเมลรีเซ็ตรหัสผ่านจะส่งไปยังที่อยู่ใหม่ "
"ผู้ดูแลระบบจึงอาจต้องกู้คืนที่อยู่ของคุณก่อน"

#: specivo/services/email_change_service.py:752
#: specivo/services/email_change_service.py:763 specivo/web/pages/admin.py:250
msgid "A user with this email already exists"
msgstr "มีผู้ใช้ที่ใช้อีเมลนี้อยู่แล้ว"

#: specivo/services/email_change_service.py:783
#, python-format
msgid ""
"An administrator changed the email address of your %(brand)s account "
"%(login)s to %(address)s."
msgstr ""
"ผู้ดูแลระบบได้เปลี่ยนที่อยู่อีเมลของบัญชี %(login)s ใน %(brand)s "
"ของคุณเป็น %(address)s"

#: specivo/services/email_change_service.py:787
#, python-format
msgid "If you did not expect this, contact an administrator of %(brand)s."
msgstr "หากคุณไม่ได้คาดว่าจะเกิดขึ้น โปรดติดต่อผู้ดูแลระบบของ %(brand)s"

#: specivo/services/issue_service.py:98
msgid "No issue statuses found; run seed data first"
msgstr "ไม่พบสถานะของงาน กรุณารัน seed data ก่อน"

#: specivo/services/issue_service.py:138
msgid "You do not have permission to set issue privacy"
msgstr "คุณไม่มีสิทธิ์กำหนดความเป็นส่วนตัวของงาน"

#: specivo/services/issue_service.py:140
msgid ""
"Issues of this tracker are private by default; you do not have permission"
" to change that"
msgstr "งานของแทร็กเกอร์นี้เป็นส่วนตัวโดยค่าเริ่มต้น คุณไม่มีสิทธิ์เปลี่ยนแปลง"

#: specivo/services/issue_service.py:160
msgid "No issue priorities found; run seed data first"
msgstr "ไม่พบระดับความสำคัญของงาน กรุณารัน seed data ก่อน"

#: specivo/services/issue_service.py:180
#, python-format
msgid "Version %(id)s not found"
msgstr "ไม่พบเวอร์ชัน %(id)s"

#: specivo/services/issue_service.py:186
msgid "Version does not belong to this project"
msgstr "เวอร์ชันนี้ไม่ได้อยู่ในโปรเจกต์นี้"

#: specivo/services/issue_service.py:192
#, python-format
msgid "Cannot assign issues to a %(status)s version"
msgstr "ไม่สามารถมอบหมายงานให้เวอร์ชันที่ %(status)s ได้"

#: specivo/services/issue_service.py:211
#, python-format
msgid "Sprint %(id)s not found"
msgstr "ไม่พบสปรินต์ %(id)s"

#: specivo/services/issue_service.py:217
msgid "Sprint does not belong to this project"
msgstr "สปรินต์นี้ไม่ได้อยู่ในโปรเจกต์นี้"

#: specivo/services/issue_service.py:223
msgid "Cannot assign issues to a completed sprint"
msgstr "ไม่สามารถมอบหมายงานให้สปรินต์ที่เสร็จสิ้นแล้วได้"

#: specivo/services/issue_service.py:1012
#: specivo/services/sprint_service.py:307
msgid "Issue was modified by another request. Reload and retry."
msgstr "งานถูกแก้ไขโดยคำขออื่น กรุณาโหลดใหม่แล้วลองอีกครั้ง"

#: specivo/services/issue_service.py:1175
msgid "Issue is already in this project."
msgstr "งานนี้อยู่ในโปรเจกต์นี้อยู่แล้ว"

#: specivo/services/issue_service.py:1184
msgid ""
"Cannot move an issue that is part of a hierarchy. Detach it from its "
"parent and move or detach its children first."
msgstr ""
"ไม่สามารถย้ายงานที่อยู่ในลำดับชั้นได้ กรุณาแยกงานนี้ออกจากงานหลัก "
"และย้ายหรือแยกงานย่อยของงานนี้ออกก่อน"

#: specivo/services/issue_service.py:1235
#, python-brace-format
msgid "Moved from {old} to {new}."
msgstr "ย้ายจาก {old} ไปยัง {new}"

#: specivo/services/issue_service.py:1309
#, python-brace-format
msgid ""
"Unknown status filter '{value}'. Use 'open', 'closed', 'all', a status "
"id, or one of: {known}"
