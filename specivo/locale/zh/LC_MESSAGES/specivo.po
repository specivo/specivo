msgstr "生成新密钥"

#: specivo/templates/themes/default/pages/projects/settings.html:1252
msgid "The old secret stops working at once."
msgstr "旧密钥会立即失效。"

#: specivo/templates/themes/default/pages/projects/settings.html:1256
msgid "A signing secret is generated and shown once after the webhook is created."
msgstr "创建 Webhook 后会生成签名密钥，并仅显示一次。"

#: specivo/templates/themes/default/pages/projects/settings.html:1275
#: specivo/templates/themes/default/pages/projects/settings.html:1285
msgid "Delete webhook"
msgstr "删除 Webhook"

#: specivo/templates/themes/default/pages/projects/settings.html:1281
msgid "Delete this webhook and its delivery log? Nothing more is sent to:"
msgstr "删除此 Webhook 及其投递日志？之后将不再向以下地址发送任何内容："

#: specivo/templates/themes/default/pages/projects/settings.html:1299
msgid "Failed to save the repository."
msgstr "保存仓库失败。"

#: specivo/templates/themes/default/pages/projects/settings.html:1302
#: specivo/templates/themes/default/pages/projects/settings.html:1337
