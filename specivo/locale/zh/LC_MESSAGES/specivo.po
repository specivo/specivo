msgstr "你的 {month} AI 报销申请已获批准"

#: specivo/services/ai_reimbursement_claim_service.py:105
#, python-brace-format
msgid "{actor} approved your AI reimbursement claim for {month}: {amount}."
msgstr "{actor} 批准了你的 {month} AI 报销申请：{amount}。"

#: specivo/services/ai_reimbursement_claim_service.py:106
#, python-brace-format
msgid "Your AI reimbursement claim for {month} was rejected"
msgstr "你的 {month} AI 报销申请已被驳回"

#: specivo/services/ai_reimbursement_claim_service.py:107
#, python-brace-format
msgid "{actor} rejected your AI reimbursement claim for {month}."
msgstr "{actor} 驳回了你的 {month} AI 报销申请。"

#: specivo/services/ai_reimbursement_claim_service.py:108
#, python-brace-format
msgid "Reason: {reason}"
msgstr "原因：{reason}"

#: specivo/services/ai_reimbursement_claim_service.py:109
#, python-brace-format
msgid "Your AI reimbursement claim for {month} was paid"
msgstr "你的 {month} AI 报销申请已付款"

#: specivo/services/ai_reimbursement_claim_service.py:110
#, python-brace-format
msgid "{actor} marked your AI reimbursement claim for {month} as paid: {amount}."
msgstr "{actor} 已将你的 {month} AI 报销申请标记为已付款：{amount}。"

#: specivo/services/ai_reimbursement_claim_service.py:111
msgid "View the claim"
msgstr "查看申请"

#: specivo/services/ai_reimbursement_claim_service.py:276
msgid "Only the person who made a claim can change it."
msgstr "只有提出申请的人才能修改它。"

#: specivo/services/ai_reimbursement_claim_service.py:280
msgid "Only administrators approve, reject or pay AI reimbursement claims."
msgstr "只有管理员可以批准、驳回 AI 报销申请或为其付款。"

#: specivo/services/ai_reimbursement_claim_service.py:282
msgid "You cannot decide on your own AI reimbursement claim."
msgstr "你不能审批自己的 AI 报销申请。"

#: specivo/services/ai_reimbursement_claim_service.py:317
msgid "Only administrators see everyone's AI reimbursement claims."
msgstr "只有管理员可以查看所有人的 AI 报销申请。"

#: specivo/services/ai_reimbursement_claim_service.py:436
#: specivo/templates/themes/default/pages/auth/ai_reimbursement_claims.html:22
msgid "Service accounts do not make AI reimbursement claims."
msgstr "服务账户不提交 AI 报销申请。"

#: specivo/services/ai_spend_budget_service.py:96
#, python-brace-format
msgid ""
"AI spend budget: {name} reached {threshold} percent of its budget for "
