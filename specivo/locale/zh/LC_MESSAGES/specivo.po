#: specivo/web/pages/admin.py:219
msgid ""
"Account deactivated. The user was signed out everywhere and their API "
"keys were switched off."
msgstr "账户已停用。该用户已在所有位置退出登录，其 API 密钥已关闭。"

#: specivo/web/pages/admin.py:222
msgid ""
"Account reactivated. The user can sign in again. API keys stay inactive: "
"activate them again or create new ones."
msgstr "账户已重新启用。该用户可以再次登录。API 密钥仍保持停用：请重新启用或创建新密钥。"

#: specivo/web/pages/admin.py:232
msgid "You cannot deactivate your own account."
msgstr "您不能停用自己的账户。"

#: specivo/web/pages/auth.py:211
msgid "No reset token provided. Please use the link from your email."
msgstr "未提供重置令牌。请使用邮件中的链接。"

#: specivo/web/pages/auth.py:219
msgid "This password reset link is invalid. Please request a new one."
msgstr "该密码重置链接无效。请重新申请一个。"

#: specivo/web/pages/auth.py:221
msgid "This password reset link has already been used. Please request a new one."
msgstr "该密码重置链接已被使用。请重新申请一个。"

#: specivo/web/pages/auth.py:223
msgid "This password reset link has expired. Please request a new one."
msgstr "该密码重置链接已过期。请重新申请一个。"

