#, python-brace-format
msgid ""
"{holder} submitted an AI reimbursement claim for {month}: {amount}, "
"{entries} entries."
msgstr "{holder} 提交了 {month} 的 AI 报销申请：{amount}，共 {entries} 条记录。"

