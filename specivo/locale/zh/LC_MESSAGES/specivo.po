#: specivo/mcp/ai_subscription_tools.py:145
msgid ""
"AI subscriptions belong to your account, not to a project: connect with "
"an unlimited personal API key to manage them."
msgstr "AI 订阅属于你的账户，而不是某个项目：请使用不受限制的个人 API 密钥连接来管理它们。"

#: specivo/mcp/ai_subscription_tools.py:152
msgid ""
"AI subscriptions belong to people, not to service accounts: connect with "
"your personal API key, or ask an administrator to record them."
msgstr "AI 订阅属于个人，而不是服务账户：请使用你的个人 API 密钥连接，或请管理员代为登记。"

#: specivo/mcp/ai_subscription_tools.py:163
msgid "Only administrators manage other people's AI subscriptions."
msgstr "只有管理员可以管理其他人的 AI 订阅。"

#: specivo/schemas/auth.py:97
msgid ""
"The project limit must be an object with a single \"projects\" list "
"naming 1 to 200 projects by key or id."
msgstr "项目限制必须是一个对象，且只包含一个 \"projects\" 列表，按键或 ID 列出 1 到 200 个项目。"

#: specivo/services/api_key_scope.py:165
msgid "This API key is limited to specific projects and cannot do this."
msgstr "此 API 密钥仅限于特定项目，无法执行此操作。"

#: specivo/services/api_key_service.py:64
#: specivo/services/api_key_service.py:72
msgid "Client IP not allowed by key allowlist"
msgstr "客户端 IP 不在密钥允许列表中"

#: specivo/services/api_key_service.py:94
msgid ""
"API keys are turned off for accounts that sign in through single sign-on."
" Ask an administrator if you need one."
msgstr "通过单点登录登录的账户已关闭 API 密钥。如需密钥，请联系管理员。"

#: specivo/services/api_key_service.py:161
#, python-brace-format
msgid ""
"This account has reached the limit of {limit} API keys. Delete keys it no"
" longer needs."
msgstr "此账户的 API 密钥已达上限（{limit} 个）。请删除不再需要的密钥。"

#: specivo/services/api_key_service.py:201
#, python-brace-format
msgid "There is no project \"{project}\" that this key can be limited to."
msgstr "没有可将此密钥限制到的项目 \"{project}\"。"

