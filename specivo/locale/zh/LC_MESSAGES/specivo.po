msgstr "API 密钥已过期"

#: specivo/services/api_key_service.py:301
#: specivo/services/api_key_service.py:330
msgid "API key not found"
msgstr "未找到 API 密钥"

#: specivo/services/auth_service.py:225 specivo/services/auth_service.py:246
