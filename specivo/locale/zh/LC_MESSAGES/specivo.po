#: specivo/mcp/ai_billing_account_tools.py:62
msgid ""
"AI billing accounts belong to the instance or to a person, not to a "
"project: connect with an unlimited API key to manage them."
msgstr "AI 计费账户属于实例或个人，而不是某个项目：请使用不受限制的 API 密钥连接来管理它们。"

#: specivo/mcp/ai_billing_account_tools.py:76
msgid "Only administrators manage other people's AI billing accounts."
msgstr "只有管理员可以管理其他人的 AI 计费账户。"

#: specivo/mcp/ai_reimbursement_claim_tools.py:209
msgid "Only administrators see other people's AI reimbursement claims."
msgstr "只有管理员可以查看其他人的 AI 报销申请。"

#: specivo/mcp/ai_spend_budget_tools.py:49
msgid ""
"AI spend budgets belong to a billing account or a payer, not to a "
"project: connect with an unlimited API key to manage them."
msgstr "AI 支出预算属于计费账户或付款方，而不是某个项目：请使用不受限制的 API 密钥连接来管理它们。"

#: specivo/mcp/ai_subscription_tools.py:171
msgid ""
"AI subscriptions belong to your account, not to a project: connect with "
"an unlimited personal API key to manage them."
msgstr "AI 订阅属于你的账户，而不是某个项目：请使用不受限制的个人 API 密钥连接来管理它们。"

#: specivo/mcp/ai_subscription_tools.py:178
msgid ""
"AI subscriptions belong to people, not to service accounts: connect with "
"your personal API key, or ask an administrator to record them."
msgstr "AI 订阅属于个人，而不是服务账户：请使用你的个人 API 密钥连接，或请管理员代为登记。"

#: specivo/mcp/ai_subscription_tools.py:189
msgid "Only administrators manage other people's AI subscriptions."
msgstr "只有管理员可以管理其他人的 AI 订阅。"

#: specivo/mcp/ai_subscription_tools.py:560
msgid ""
"Company AI plans belong to the instance, not to a project: connect with "
"an unlimited API key."
msgstr "公司 AI 套餐属于实例，而不是某个项目：请使用不受限制的 API 密钥连接。"

#: specivo/mcp/ai_subscription_tools.py:563
msgid "Only administrators manage company AI plans."
msgstr "只有管理员可以管理公司 AI 套餐。"

#: specivo/schemas/auth.py:97
msgid ""
"The project limit must be an object with a single \"projects\" list "
"naming 1 to 200 projects by key or id."
msgstr "项目限制必须是一个对象，且只包含一个 \"projects\" 列表，按键或 ID 列出 1 到 200 个项目。"

#: specivo/services/ai_provider_service.py:56
#, python-format
msgid "Enter the provider's base URL, at most %(count)d characters"
msgstr "请输入提供商的基础 URL，最多 %(count)d 个字符"

#: specivo/services/ai_provider_service.py:61
#, python-format
msgid ""
"The base URL starts with http:// or https:// and names a host, for "
"example %(example)s"
msgstr "基础 URL 以 http:// 或 https:// 开头并包含主机名，例如 %(example)s"

#: specivo/services/ai_provider_service.py:67
msgid ""
"The base URL must not hold a user name, password, query or fragment; "
"enter the key in its own field"
msgstr "基础 URL 不能包含用户名、密码、查询参数或片段；请在单独的字段中输入密钥"

#: specivo/services/ai_provider_service.py:71
msgid "The base URL must not contain spaces or control characters"
msgstr "基础 URL 不能包含空格或控制字符"

#: specivo/services/ai_provider_service.py:98
#, python-format
msgid "Enter the model name, at most %(count)d characters"
msgstr "请输入模型名称，最多 %(count)d 个字符"

#: specivo/services/ai_provider_service.py:105
#, python-format
msgid "Enter a provider name, at most %(count)d characters"
msgstr "请输入提供商名称，最多 %(count)d 个字符"

#: specivo/services/ai_provider_service.py:125
#, python-format
msgid "The API key is at most %(count)d printable characters"
msgstr "API 密钥最多 %(count)d 个可打印字符"

#: specivo/services/ai_reimbursement_claim_service.py:102
#, python-brace-format
msgid "AI reimbursement claim from {holder} for {month}"
msgstr "{holder} 的 {month} AI 报销申请"

