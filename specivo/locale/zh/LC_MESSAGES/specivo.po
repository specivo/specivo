msgstr "连接仓库"

#: specivo/templates/themes/default/pages/projects/settings.html:1303
msgid "Edit repository"
msgstr "编辑仓库"

#: specivo/templates/themes/default/pages/projects/settings.html:1304
msgid "Connect repository"
msgstr "连接仓库"

#: specivo/templates/themes/default/pages/projects/settings.html:1308
msgid "Never received"
msgstr "从未收到"

#: specivo/templates/themes/default/pages/projects/settings.html:1309
