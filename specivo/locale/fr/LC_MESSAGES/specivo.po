#: specivo/mcp/ai_subscription_tools.py:145
msgid ""
"AI subscriptions belong to your account, not to a project: connect with "
"an unlimited personal API key to manage them."
msgstr ""
"Les abonnements IA appartiennent à votre compte, pas à un projet : "
"connectez-vous avec une clé API personnelle sans limite pour les gérer."

#: specivo/mcp/ai_subscription_tools.py:152
msgid ""
"AI subscriptions belong to people, not to service accounts: connect with "
"your personal API key, or ask an administrator to record them."
msgstr ""
"Les abonnements IA appartiennent à des personnes, pas à des comptes de "
"service : connectez-vous avec votre clé API personnelle, ou demandez à un"
" administrateur de les enregistrer."

#: specivo/mcp/ai_subscription_tools.py:163
msgid "Only administrators manage other people's AI subscriptions."
msgstr "Seuls les administrateurs gèrent les abonnements IA des autres personnes."

#: specivo/schemas/auth.py:97
msgid ""
"The project limit must be an object with a single \"projects\" list "
"naming 1 to 200 projects by key or id."
msgstr ""
"La limite de projets doit être un objet avec une seule liste « projects »"
" indiquant de 1 à 200 projets par clé ou id."

#: specivo/services/api_key_scope.py:165
msgid "This API key is limited to specific projects and cannot do this."
msgstr ""
"Cette clé API est limitée à certains projets et ne peut pas effectuer "
"cette action."

#: specivo/services/api_key_service.py:64
#: specivo/services/api_key_service.py:72
msgid "Client IP not allowed by key allowlist"
msgstr "IP du client non autorisée par la liste d'autorisation de la clé"

#: specivo/services/api_key_service.py:94
msgid ""
"API keys are turned off for accounts that sign in through single sign-on."
" Ask an administrator if you need one."
msgstr ""
"Les clés API sont désactivées pour les comptes qui se connectent par "
"authentification unique. Demandez-en une à un administrateur si "
"nécessaire."

#: specivo/services/api_key_service.py:161
#, python-brace-format
msgid ""
"This account has reached the limit of {limit} API keys. Delete keys it no"
" longer needs."
msgstr ""
"Ce compte a atteint la limite de {limit} clés API. Supprimez les clés "
"dont il n'a plus besoin."

#: specivo/services/api_key_service.py:201
#, python-brace-format
msgid "There is no project \"{project}\" that this key can be limited to."
msgstr "Il n'existe aucun projet « {project} » auquel cette clé peut être limitée."

#: specivo/services/api_key_service.py:230
#: specivo/services/api_key_service.py:260
msgid "Invalid API key"
msgstr "Clé API invalide"

#: specivo/services/api_key_service.py:239
msgid "API key is inactive"
msgstr "La clé API est inactive"

#: specivo/services/api_key_service.py:246
msgid "API key has expired"
msgstr "La clé API a expiré"

#: specivo/services/api_key_service.py:301
#: specivo/services/api_key_service.py:330
msgid "API key not found"
msgstr "Clé API introuvable"

#: specivo/services/auth_service.py:225 specivo/services/auth_service.py:246
#: specivo/services/auth_service.py:278
msgid "Invalid login or password"
msgstr "Identifiant ou mot de passe invalide"

#: specivo/services/auth_service.py:250
msgid "Email address not verified"
msgstr "Adresse e-mail non vérifiée"

#: specivo/services/auth_service.py:252
msgid "Account has been deactivated"
msgstr "Le compte a été désactivé"

#: specivo/services/auth_service.py:256
msgid "Service accounts cannot log in. Use an API key instead."
msgstr ""
"Les comptes de service ne peuvent pas se connecter. Utilisez plutôt une "
"clé API."

#: specivo/services/auth_service.py:262
msgid "Account is temporarily locked due to too many failed login attempts"
msgstr ""
"Le compte est temporairement verrouillé en raison d'un trop grand nombre "
"de tentatives de connexion échouées"

#: specivo/services/auth_service.py:296
msgid "Account is locked. Contact an administrator."
msgstr "Le compte est verrouillé. Contactez un administrateur."

#: specivo/services/auth_service.py:425
msgid "Refresh token expired or revoked"
msgstr "Jeton de rafraîchissement expiré ou révoqué"

#: specivo/services/auth_service.py:715
msgid "Session not found"
msgstr "Session introuvable"

#: specivo/services/auth_service.py:811 specivo/services/auth_service.py:840
msgid "Invalid or expired password reset link"
msgstr "Lien de réinitialisation du mot de passe invalide ou expiré"

#: specivo/services/auth_service.py:819
msgid "This password reset link has already been used"
msgstr "Ce lien de réinitialisation du mot de passe a déjà été utilisé"

#: specivo/services/auth_service.py:827
msgid "This password reset link has expired"
msgstr "Ce lien de réinitialisation du mot de passe a expiré"

#: specivo/services/auth_service.py:899
msgid "This account has no password. It authenticates with an API key."
msgstr "Ce compte n'a pas de mot de passe. Il s'authentifie avec une clé API."

#: specivo/services/auth_service.py:906
msgid ""
"This account has no password. You sign in through your identity provider,"
" so there is no password to change here."
msgstr ""
"Ce compte n'a pas de mot de passe. Vous vous connectez via votre "
"fournisseur d'identité, il n'y a donc pas de mot de passe à modifier ici."

#: specivo/services/auth_service.py:917
#: specivo/services/email_change_service.py:182
msgid "Current password is incorrect"
msgstr "Le mot de passe actuel est incorrect"

#: specivo/services/auth_service.py:927
#: specivo/templates/themes/default/pages/auth/_change_password_form.html:23
msgid "The new password must be different from the current one"
msgstr "Le nouveau mot de passe doit être différent de l'actuel"

#: specivo/services/auth_utils.py:239
#: specivo/templates/themes/default/pages/auth/_change_password_form.html:21
#, python-format
msgid "Password must be at least %(count)d characters"
msgstr "Le mot de passe doit comporter au moins %(count)d caractères"

#: specivo/services/email_change_service.py:175
msgid "This account cannot change its email address here."
msgstr "Ce compte ne peut pas modifier son adresse e-mail ici."

#: specivo/services/email_change_service.py:177
#: specivo/templates/themes/default/pages/auth/profile.html:145
msgid ""
"Your email address is managed by your identity provider. Change it at "
"your identity provider."
msgstr ""
"Votre adresse e-mail est gérée par votre fournisseur d'identité. "
"Modifiez-la auprès de votre fournisseur d'identité."

#: specivo/services/email_change_service.py:180
msgid ""
"Sign in again with your identity provider, then request the change within"
" five minutes."
msgstr ""
"Reconnectez-vous avec votre fournisseur d'identité, puis demandez la "
"modification dans les cinq minutes."

#: specivo/services/email_change_service.py:183 specivo/web/pages/admin.py:250
msgid "Enter a valid email address."
msgstr "Saisissez une adresse e-mail valide."

#: specivo/services/email_change_service.py:184
msgid "This is already your email address."
msgstr "C'est déjà votre adresse e-mail."

#: specivo/services/email_change_service.py:185
msgid "There is no pending email change."
msgstr "Aucune modification d'adresse e-mail n'est en attente."

#: specivo/services/email_change_service.py:186
msgid "Too many email change requests. Please try again later."
msgstr ""
"Trop de demandes de modification d'adresse e-mail. Veuillez réessayer "
"plus tard."

#: specivo/services/email_change_service.py:187
msgid "This confirmation link is not valid."
msgstr "Ce lien de confirmation n'est pas valide."

#: specivo/services/email_change_service.py:188
msgid "This confirmation link has already been used."
msgstr "Ce lien de confirmation a déjà été utilisé."

#: specivo/services/email_change_service.py:190
msgid ""
"This confirmation link is no longer valid. Use the most recent link, or "
"request the change again."
msgstr ""
"Ce lien de confirmation n'est plus valide. Utilisez le lien le plus "
"récent, ou demandez à nouveau la modification."

#: specivo/services/email_change_service.py:192
msgid "This confirmation link has expired. Request the change again."
msgstr "Ce lien de confirmation a expiré. Demandez à nouveau la modification."

#: specivo/services/email_change_service.py:194
msgid ""
"This email address is now used by another account. Your address was not "
"changed."
msgstr ""
"Cette adresse e-mail est désormais utilisée par un autre compte. Votre "
"adresse n'a pas été modifiée."

#: specivo/services/email_change_service.py:197
msgid "The email address could not be changed. Please try again."
msgstr "L'adresse e-mail n'a pas pu être modifiée. Veuillez réessayer."

#: specivo/services/email_change_service.py:277
#, python-format
msgid "Hi %(name)s,"
msgstr "Bonjour %(name)s,"

#: specivo/services/email_change_service.py:532
#, python-format
msgid "Confirm your new email address for %(brand)s"
msgstr "Confirmez votre nouvelle adresse e-mail pour %(brand)s"

#: specivo/services/email_change_service.py:536
#, python-format
msgid ""
"Someone, hopefully you, asked to use this address for the %(brand)s "
"account %(login)s. Confirm the change to make it the account's email "
"address."
msgstr ""
"Quelqu'un, vous sans doute, a demandé à utiliser cette adresse pour le "
"compte %(login)s de %(brand)s. Confirmez la modification pour en faire "
"l'adresse e-mail du compte."

#: specivo/services/email_change_service.py:541
#, python-format
msgid ""
"This link expires in %(hours)s hours. Only the most recent link works. "
"Until you confirm, the account keeps its current address."
msgstr ""
"Ce lien expire dans %(hours)s heures. Seul le lien le plus récent "
"fonctionne. Tant que vous n'avez pas confirmé, le compte conserve son "
"adresse actuelle."

#: specivo/services/email_change_service.py:545
msgid "If you did not ask for this, ignore this email. Nothing changes."
msgstr ""
"Si vous n'êtes pas à l'origine de cette demande, ignorez cet e-mail. Rien"
" ne change."

#: specivo/services/email_change_service.py:548
#: specivo/templates/themes/default/pages/auth/confirm_email.html:3
#: specivo/templates/themes/default/pages/auth/confirm_email.html:16
#: specivo/templates/themes/default/pages/auth/confirm_email.html:48
msgid "Confirm email address"
msgstr "Confirmer l'adresse e-mail"

#: specivo/services/email_change_service.py:555
#, python-format
msgid "Someone tried to use your email address on %(brand)s"
msgstr "Quelqu'un a essayé d'utiliser votre adresse e-mail sur %(brand)s"

#: specivo/services/email_change_service.py:559
#, python-format
msgid ""
"Someone tried to use this address for another %(brand)s account. This "
"address already belongs to your account, so nothing was changed."
msgstr ""
"Quelqu'un a essayé d'utiliser cette adresse pour un autre compte "
"%(brand)s. Cette adresse appartient déjà à votre compte, rien n'a donc "
"été modifié."

#: specivo/services/email_change_service.py:564
msgid ""
"If it was you, sign in to the account that already uses this address. If "
"you have forgotten its password, reset it here:"
msgstr ""
"Si c'était vous, connectez-vous au compte qui utilise déjà cette adresse."
" Si vous avez oublié son mot de passe, réinitialisez-le ici :"

#: specivo/services/email_change_service.py:567
msgid "If you do not recognise this, you can ignore this email."
msgstr "Si vous ne reconnaissez pas cette action, vous pouvez ignorer cet e-mail."

#: specivo/services/email_change_service.py:570
#: specivo/services/email_change_service.py:707
msgid "Reset password"
msgstr "Réinitialiser le mot de passe"

#: specivo/services/email_change_service.py:694
#: specivo/services/email_change_service.py:772
#, python-format
msgid "Your %(brand)s email address was changed"
msgstr "Votre adresse e-mail %(brand)s a été modifiée"

#: specivo/services/email_change_service.py:697
#, python-format
msgid "Your %(brand)s email was changed to %(address)s."
msgstr "Votre adresse e-mail %(brand)s a été remplacée par %(address)s."

#: specivo/services/email_change_service.py:700
#, python-format
msgid ""
"If you did not do this, reset your password straight away and contact an "
"administrator of %(brand)s. Password reset emails now go to the new "
"address, so an administrator may have to restore your address first."
msgstr ""
"Si vous n'êtes pas à l'origine de cette modification, réinitialisez "
"immédiatement votre mot de passe et contactez un administrateur de "
"%(brand)s. Les e-mails de réinitialisation du mot de passe partent "
"désormais vers la nouvelle adresse : un administrateur devra peut-être "
"d'abord rétablir votre adresse."

#: specivo/services/email_change_service.py:745
#: specivo/services/email_change_service.py:756 specivo/web/pages/admin.py:252
msgid "A user with this email already exists"
msgstr "Un utilisateur avec cette adresse e-mail existe déjà"

#: specivo/services/email_change_service.py:776
#, python-format
msgid ""
"An administrator changed the email address of your %(brand)s account "
"%(login)s to %(address)s."
msgstr ""
"Un administrateur a remplacé l'adresse e-mail de votre compte %(login)s "
"de %(brand)s par %(address)s."

#: specivo/services/email_change_service.py:780
#, python-format
msgid "If you did not expect this, contact an administrator of %(brand)s."
msgstr "Si vous ne vous y attendiez pas, contactez un administrateur de %(brand)s."

#: specivo/services/issue_service.py:98
msgid "No issue statuses found; run seed data first"
msgstr "Aucun statut de ticket trouvé ; exécutez d'abord les données initiales"

#: specivo/services/issue_service.py:138
msgid "You do not have permission to set issue privacy"
msgstr "Vous n'avez pas l'autorisation de modifier la confidentialité des demandes"

#: specivo/services/issue_service.py:140
msgid ""
"Issues of this tracker are private by default; you do not have permission"
" to change that"
msgstr ""
"Les demandes de ce tracker sont privées par défaut ; vous n'avez pas "
"l'autorisation de changer cela"

#: specivo/services/issue_service.py:160
msgid "No issue priorities found; run seed data first"
msgstr "Aucune priorité de ticket trouvée ; exécutez d'abord les données initiales"

#: specivo/services/issue_service.py:180
#, python-format
msgid "Version %(id)s not found"
msgstr "Version %(id)s introuvable"

#: specivo/services/issue_service.py:186
msgid "Version does not belong to this project"
msgstr "La version n'appartient pas à ce projet"

#: specivo/services/issue_service.py:192
#, python-format
msgid "Cannot assign issues to a %(status)s version"
msgstr "Impossible d'assigner des tickets à une version %(status)s"

#: specivo/services/issue_service.py:211
#, python-format
msgid "Sprint %(id)s not found"
msgstr "Sprint %(id)s introuvable"

#: specivo/services/issue_service.py:217
msgid "Sprint does not belong to this project"
msgstr "Le sprint n'appartient pas à ce projet"

#: specivo/services/issue_service.py:223
msgid "Cannot assign issues to a completed sprint"
msgstr "Impossible d'assigner des tickets à un sprint terminé"

#: specivo/services/issue_service.py:1008
#: specivo/services/sprint_service.py:307
msgid "Issue was modified by another request. Reload and retry."
msgstr "Le ticket a été modifié par une autre requête. Rechargez et réessayez."

#: specivo/services/issue_service.py:1175
msgid "Issue is already in this project."
msgstr "Le ticket se trouve déjà dans ce projet."

#: specivo/services/issue_service.py:1184
msgid ""
"Cannot move an issue that is part of a hierarchy. Detach it from its "
"parent and move or detach its children first."
msgstr ""
"Impossible de déplacer un ticket qui fait partie d'une hiérarchie. "
"Détachez-le de son parent, et déplacez ou détachez d'abord ses tickets "
"enfants."

#: specivo/services/issue_service.py:1235
#, python-brace-format
msgid "Moved from {old} to {new}."
msgstr "Déplacé de {old} vers {new}."

#: specivo/services/issue_service.py:1309
#, python-brace-format
msgid ""
"Unknown status filter '{value}'. Use 'open', 'closed', 'all', a status "
"id, or one of: {known}"
msgstr ""
"Filtre de statut inconnu « {value} ». Utilisez 'open', 'closed', 'all', "
"un identifiant de statut ou l'une des valeurs suivantes : {known}"

#: specivo/services/journal_service.py:313
msgid "The history entry does not belong to this issue."
msgstr "Cette entrée d'historique n'appartient pas à ce ticket."

#: specivo/services/journal_service.py:464
msgid "Cannot reply to a journal on a different issue"
msgstr "Impossible de répondre à un journal sur un autre ticket"

#: specivo/services/markdown_budget.py:134
#, python-brace-format
msgid "Text is too long ({length} characters); the limit is {limit}."
msgstr "Le texte est trop long ({length} caractères) ; la limite est de {limit}."

#: specivo/services/markdown_service.py:396
msgid "This text is too complex to format, so it is shown as plain text."
msgstr ""
"Ce texte est trop complexe pour être mis en forme ; il est donc affiché "
"en texte brut."

#: specivo/services/metadata_schema_service.py:53
#, python-brace-format
msgid "Invalid JSON Schema: {reason}"
msgstr "JSON Schema non valide : {reason}"

#: specivo/services/metadata_schema_service.py:147
#, python-brace-format
msgid "Metadata does not match schema '{schema}': {reason}"
msgstr "Les métadonnées ne respectent pas le schéma '{schema}' : {reason}"

#: specivo/services/metadata_schema_service.py:151
#, python-brace-format
msgid "Metadata field '{key}' does not match schema '{schema}': {reason}"
msgstr ""
"Le champ de métadonnées '{key}' ne respecte pas le schéma '{schema}' : "
"{reason}"

#: specivo/services/nested_set_service.py:40
#, python-format
msgid ""
"Hierarchy depth limit exceeded: with this parent the hierarchy, sub-tasks"
" included, would be %(levels)s levels deep, and at most %(max)s are "
"allowed."
msgstr ""
"Limite de profondeur de la hiérarchie dépassée : avec ce parent, la "
"hiérarchie, sous-tâches comprises, aurait %(levels)s niveaux de "
"profondeur, alors que %(max)s au maximum sont autorisés."

#: specivo/services/recurring_pattern_service.py:252
#: specivo/templates/themes/default/pages/projects/recurring_pattern_form.html:31
msgid "This pattern was changed by someone else. Reload and try again."
msgstr "Ce modèle a été modifié par quelqu'un d'autre. Rechargez et réessayez."

#: specivo/services/scim/config_service.py:102
msgid "Generate a SCIM token before turning provisioning on."
msgstr "Générez un jeton SCIM avant d'activer le provisionnement."

#: specivo/services/sprint_service.py:270
msgid "Cannot move issues to the sprint being completed"
msgstr "Impossible de déplacer des tickets vers le sprint en cours de clôture"

#: specivo/services/user_service.py:73 specivo/web/pages/admin.py:249
msgid ""
"This is the last active administrator. Make another user an administrator"
" first."
msgstr ""
"C'est le dernier administrateur actif. Nommez d'abord un autre "
"utilisateur administrateur."

#: specivo/services/workflow_service.py:224
msgid "No project roles found for user"
msgstr "Aucun rôle de projet trouvé pour l'utilisateur"

#: specivo/services/workflow_service.py:234
#, python-brace-format
msgid "Transition from status {old} to {new} is not allowed"
msgstr "La transition du statut {old} vers {new} n'est pas autorisée"

#: specivo/services/workflow_service.py:301
#, python-brace-format
msgid "Field '{field}' is required for this status"
msgstr "Le champ « {field} » est requis pour ce statut"

#: specivo/services/workflow_service.py:308
#, python-brace-format
msgid "Field '{field}' is read-only for this status"
msgstr "Le champ « {field} » est en lecture seule pour ce statut"

#: specivo/services/workflow_service.py:366
msgid "Duplicate workflow transition"
msgstr "Transition de workflow en double"

#: specivo/services/workflow_service.py:379
msgid "Workflow transition not found"
msgstr "Transition de workflow introuvable"

#: specivo/services/workflow_service.py:447
msgid "Duplicate workflow field rule"
msgstr "Règle de champ de workflow en double"

#: specivo/services/workflow_service.py:459
msgid "Workflow field rule not found"
msgstr "Règle de champ de workflow introuvable"

#: specivo/templates/themes/default/base.html:18
msgid "This diagram could not be drawn. Its source is shown below."
msgstr "Impossible de dessiner ce diagramme. Sa source est affichée ci-dessous."

#: specivo/templates/themes/default/base.html:42
msgid "You are reading a public project. Sign in to take part."
msgstr "Vous consultez un projet public. Connectez-vous pour participer."

#: specivo/templates/themes/default/base.html:43
#: specivo/templates/themes/default/components/header.html:143
#: specivo/templates/themes/default/pages/auth/login.html:3
#: specivo/templates/themes/default/pages/auth/login.html:67
#: specivo/templates/themes/default/pages/auth/login.html:157
msgid "Sign in"
msgstr "Se connecter"

#: specivo/templates/themes/default/base.html:48
msgid "Powered by"
msgstr "Propulsé par"

#: specivo/templates/themes/default/components/app_url_warning.html:18
msgid "This page is open under another address than APP_URL"
msgstr "Cette page est ouverte sous une autre adresse que APP_URL"

#: specivo/templates/themes/default/components/app_url_warning.html:19
#, python-format
msgid ""
"The URLs below are built from the APP_URL setting, "
"<code>%(app_url)s</code>, but this page was opened at "
"<code>%(host)s</code>. If that is the address others use to reach "
"Specivo, set APP_URL to it, or the URLs you copy may not reach this "
"instance."
msgstr ""
"Les URL ci-dessous sont construites à partir du paramètre APP_URL, "
"<code>%(app_url)s</code>, mais cette page a été ouverte à "
"<code>%(host)s</code>. Si c'est l'adresse que les autres utilisent pour "
"joindre Specivo, réglez APP_URL sur celle-ci ; sinon, les URL que vous "
"copiez risquent de ne pas atteindre cette instance."

#: specivo/templates/themes/default/components/app_url_warning.html:21
msgid "APP_URL points at this machine"
msgstr "APP_URL désigne cette machine"

#: specivo/templates/themes/default/components/app_url_warning.html:22
#, python-format
msgid ""
