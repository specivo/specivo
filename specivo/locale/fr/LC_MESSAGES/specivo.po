#: specivo/templates/themes/default/pages/admin/sso_provider_detail.html:60
msgid "The client secret environment variable name is not allowed."
msgstr "Le nom de la variable d'environnement du secret client n'est pas autorisé."

#: specivo/templates/themes/default/pages/admin/sso_provider_detail.html:61
msgid "No client secret is set."
msgstr "Aucun secret client n'est défini."

#: specivo/templates/themes/default/pages/admin/sso_provider_detail.html:62
msgid ""
"Session check is on, but the provider does not advertise the "
"refresh_token grant."
msgstr ""
"La vérification de session est activée, mais le fournisseur n'annonce pas"
" le type d'autorisation refresh_token."

#: specivo/templates/themes/default/pages/admin/sso_provider_detail.html:63
msgid ""
"The last sign-in returned no refresh token, so sessions are not checked "
"at the provider. Some providers need the offline_access scope."
msgstr ""
"La dernière connexion n'a renvoyé aucun jeton d'actualisation : les "
"sessions ne sont donc pas vérifiées auprès du fournisseur. Certains "
"fournisseurs exigent la portée offline_access."

#: specivo/templates/themes/default/pages/admin/sso_provider_detail.html:64
msgid ""
"The provider refused the refresh token right after sign-in, so sessions "
"are not checked at the provider. Allow the refresh_token grant for this "
"client."
msgstr ""
"Le fournisseur a refusé le jeton d'actualisation juste après la connexion"
" : les sessions ne sont donc pas vérifiées auprès du fournisseur. "
"Autorisez le type d'autorisation refresh_token pour ce client."

#: specivo/templates/themes/default/pages/admin/sso_provider_detail.html:67
msgid "Works: sessions are checked at the provider"
msgstr "Fonctionne : les sessions sont vérifiées auprès du fournisseur"

#: specivo/templates/themes/default/pages/admin/sso_provider_detail.html:68
msgid "Not available: the provider sent no refresh token"
msgstr "Indisponible : le fournisseur n'a envoyé aucun jeton d'actualisation"

#: specivo/templates/themes/default/pages/admin/sso_provider_detail.html:69
msgid "Not available: the provider refused the refresh token"
msgstr "Indisponible : le fournisseur a refusé le jeton d'actualisation"

#: specivo/templates/themes/default/pages/admin/sso_provider_detail.html:70
msgid "Not known yet: no sign-in since it was turned on"
msgstr "Pas encore connu : aucune connexion depuis l'activation"

#: specivo/templates/themes/default/pages/admin/sso_provider_detail.html:71
msgid "Off"
msgstr "Désactivée"

