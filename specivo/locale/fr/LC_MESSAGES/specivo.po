#: specivo/templates/themes/default/pages/admin/exchange_rates.html:162
msgid "Import a CSV file"
msgstr "Importer un fichier CSV"

#: specivo/templates/themes/default/pages/admin/exchange_rates.html:163
#, python-format
msgid ""
"One rate per line: <code>date,base,quote,rate</code>, for example "
"<code>2026-11-05,USD,THB,32.45</code>. The header line is optional; dates"
" are YYYY-MM-DD and rates use a dot. A file with any bad line imports "
"nothing. Up to %(size)s MB."
msgstr ""
"Un taux par ligne : <code>date,base,quote,rate</code>, par exemple "
"<code>2026-11-05,USD,THB,32.45</code>. La ligne d’en-tête est facultative"
" ; les dates sont au format AAAA-MM-JJ et les taux utilisent un point. Un"
" fichier contenant une seule ligne incorrecte n’importe rien. Jusqu’à "
"%(size)s Mo."

