msgstr "Vous n'avez pas l'autorisation d'ajouter des fichiers ici."

#: specivo/api/v1/attachments.py:171 specivo/api/v1/attachments.py:194
msgid "You do not have permission to change this file."
msgstr "Vous n'avez pas l'autorisation de modifier ce fichier."

#: specivo/core/notification_templates.py:23
#, python-brace-format
