msgid "Production"
msgstr ""

#: specivo/templates/themes/default/pages/projects/settings.html:1624
msgid "Staging"
msgstr ""

#: specivo/templates/themes/default/pages/projects/settings.html:1625
msgid "Testing"
msgstr ""

