msgstr "Последняя загрузка %(at)s не удалась: %(reason)s"

#: specivo/templates/themes/default/pages/admin/exchange_rates.html:245
msgid "No fetch has run yet."
msgstr "Загрузок ещё не было."

#: specivo/templates/themes/default/pages/admin/exchange_rates.html:248
msgid "Fetch now"
msgstr "Загрузить сейчас"

#: specivo/templates/themes/default/pages/admin/exchange_rates.html:251
msgid ""
"Source of fetched rates: European Central Bank, euro foreign exchange "
"reference rates. The ECB publishes them for information purposes only; "
"they are not meant for transactions."
msgstr ""
"Источник загружаемых курсов: Европейский центральный банк, справочные "
"курсы евро. ЕЦБ публикует их только для информации; они не предназначены "
"для сделок."

